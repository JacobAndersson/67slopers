{
  "expo": {
    "name": "Rivet",
    "slug": "67slopers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "slopers67",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.sloppyslopers.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F28C6E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sloppyslopers.app",
      "permissions": ["android.permission.VIBRATE"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": { "backgroundColor": "#141A2E", "image": "./assets/images/splash-icon.png" }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "67slopers uses the camera to scan the QR code of a shared workout.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "67slopers uses Bluetooth to light problems on your MoonBoard."
        }
      ],
      "./plugins/with-bundle-inputs",
      "./plugins/with-night-window"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
